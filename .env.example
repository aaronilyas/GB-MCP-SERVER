# Copy to .env and fill in after the named tunnel exists. Never commit .env.

# Streamable HTTP bind (compose network; not a public hostname)
GB_MCP_HOST=0.0.0.0
GB_MCP_PORT=8080
GB_MCP_PATH=/mcp

# Set AFTER the named tunnel hostname exists, then restart the MCP service.
# Example: https://gb-mcp-server.com
# Used only for absolute links and /.well-known/oauth-protected-resource.
# Leave empty to derive the origin from the request Host header.
GB_MCP_PUBLIC_URL=

# Transport auth. Clients send Authorization: Bearer <token>.
# Set at least one. This is not the user's email.
GB_MCP_BEARER_TOKEN=
GB_MCP_JWT_SECRET=

# Browser Origins allowed to call /mcp (MCP Inspector, Claude web).
# Comma-separated, or * for any origin WITHOUT credentials.
# Empty = no CORS headers (Claude Desktop / Cursor stdio-style HTTP clients
# do not need CORS). Never combined with cookies/credentials.
# Example: http://localhost:6274,http://127.0.0.1:6274
GB_MCP_CORS_ORIGINS=

# Docker images (host `python server.py` and compose). Not public hostnames.
GB_ROM_VALIDATOR_IMAGE=gb-rom-validator:latest
GB_PYBOY_INSTANCE_IMAGE=gb-pyboy-instance:latest
# Set automatically by compose to ${PWD}/roms so sibling containers bind the
# host directory. Leave empty for host-run `python server.py`.
GB_ROMS_HOST_PATH=

# Cloudflare Tunnel (from Zero Trust → Networks → Tunnels). Not read by Python.
# Used only with: docker compose --profile tunnel up
TUNNEL_TOKEN=
# Public hostname routed to the origin. Substitute into cloudflared/config.example.yml.
TUNNEL_HOSTNAME=gb-mcp-server.com
