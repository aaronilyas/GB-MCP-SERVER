# Copy to .env and fill in after the named tunnel exists. Never commit .env.

# Streamable HTTP bind (compose network; not a public hostname)
GB_MCP_HOST=0.0.0.0
GB_MCP_PORT=8080
GB_MCP_PATH=/mcp

# Set AFTER the named tunnel hostname exists, then restart the MCP service.
# Example: https://gb-mcp-server.com
# Public origin for RFC 9728 resource, RFC 8414 issuer, and OAuth token iss/aud.
# Must be an exact issuer string (no trailing slash). Leave empty to derive
# the origin from the request Host header (X-Forwarded-Proto if present).
GB_MCP_PUBLIC_URL=

# Transport auth. HTTP mode requires at least one of these.
# Header-capable clients send Authorization: Bearer <GB_MCP_BEARER_TOKEN>
# or a JWT signed with GB_MCP_JWT_SECRET (HS256). This is not the user's email.
# Hosted LLM connectors use MCP OAuth 2.1 instead of a pasted header; they
# never put this value in a tool argument. OAuth access tokens are HS256 JWTs
# signed with GB_MCP_JWT_SECRET, or a key derived from GB_MCP_BEARER_TOKEN if
# the JWT secret is unset.
GB_MCP_BEARER_TOKEN=
GB_MCP_JWT_SECRET=

# Browser Origins allowed to call /mcp, well-known metadata, and OAuth routes
# (MCP Inspector, ChatGPT / Claude.ai connector UIs). Empty (default) is *
# without credentials so hosted connectors can preflight. Set none to disable
# CORS. Comma-separated list otherwise. Never combined with cookies/credentials.
# Example: http://localhost:6274,http://127.0.0.1:6274
GB_MCP_CORS_ORIGINS=

# Docker images (host `python server.py` and compose). Not public hostnames.
GB_ROM_VALIDATOR_IMAGE=gb-rom-validator:latest
GB_PYBOY_INSTANCE_IMAGE=gb-pyboy-instance:latest
# Set automatically by compose to ${PWD}/roms so sibling containers bind the
# host directory. Leave empty for host-run `python server.py`.
GB_ROMS_HOST_PATH=

# Cloudflare Tunnel (from Zero Trust → Networks → Tunnels). Not read by Python.
# Used only with: docker compose --profile tunnel up
TUNNEL_TOKEN=
# Public hostname routed to the origin. Substitute into cloudflared/config.example.yml.
TUNNEL_HOSTNAME=gb-mcp-server.com
